{
  "buildCommand": "node scripts/build-website.cjs",
  "outputDirectory": "website-dist",
  "installCommand": "",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.3dparallax.app"
        }
      ],
      "destination": "https://3dparallax.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "3dparallax.vercel.app"
        }
      ],
      "destination": "https://3dparallax.app/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/install.html",
      "destination": "/install",
      "permanent": true
    },
    {
      "source": "/wallpapers.html",
      "destination": "/wallpapers",
      "permanent": true
    },
    {
      "source": "/widgets.html",
      "destination": "/widgets",
      "permanent": true
    },
    {
      "source": "/help.html",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/changelog.html",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/site-config",
      "destination": "https://3-d-parallax-backend.vercel.app/api/config"
    },
    {
      "source": "/install",
      "destination": "/install.html"
    },
    {
      "source": "/wallpapers",
      "destination": "/wallpapers.html"
    },
    {
      "source": "/widgets",
      "destination": "/widgets.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/changelog",
      "destination": "/changelog.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-sZnHauzybJNjMcv5kBy0LE6Rmiv/codjv7x2u3EaSaE=' 'sha256-pinOw8/9paPtY/KN3amy1IuWFDkQpH0C/0sHHN7lJbg=' 'sha256-6729H0hf/73tF+TzgHQSVvn3Dd/wyN8ELQe3LpDnXVY=' 'sha256-sZolfKFIHyZ5FTRq5DwRsSvGcWiKOeepBe4ADwiFybo=' 'sha256-WxKNt49yLsuY28Pem6GN2GAkE1tQ5qOQEN4sYYrj9Z4=' 'sha256-uRtWr4vJpe0Kx5MGrnvLXQipinBsoI4sA4uwUVW+RIU=' 'sha256-uGwBKgI1Mf1WpL626nIJYBMM66n0SaGevBHoxEwjmzE='; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self' https:; media-src 'self' https: blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
