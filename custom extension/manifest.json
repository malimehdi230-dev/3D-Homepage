{
  "manifest_version": 3,
  "name": "3D Parallax",
  "short_name": "3D Parallax",
  "version": "2.2.0",
  "description": "Immersive 3D new tab with 18 themes, AI chat, custom wallpapers, live weather & deep personalisation. No sign-up needed.",
  "author": "Muhammad Ali Mehdi",
  "homepage_url": "https://3dparallax.app",
  "minimum_chrome_version": "109",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
